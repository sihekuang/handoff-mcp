{
  "name": "handoff-mcp",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "handoff": "./bin/handoff"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build:standalone": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static && cp -r db .next/standalone/db && cp -r bin .next/standalone/bin && cp -r node_modules/@modelcontextprotocol .next/standalone/node_modules/"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/cli": "^1.4.21",
    "@electric-sql/pglite": "^0.4.5",
    "@modelcontextprotocol/sdk": "^1.26",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mcp-handler": "^1.1.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "tailwindcss": "4.3.0",
    "typescript": "^5.6",
    "vitest": "^4.1.7"
